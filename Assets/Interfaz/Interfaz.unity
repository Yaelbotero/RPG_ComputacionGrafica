--- !u!114 &1954576152
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1954576150}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f079753526715c44daf397429d8a29c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RPG.UI.ConversacionDatos
  numero: 8
  titulo: Herrero Mateo
  parte: 2
  tipo: Charla con PNJ
  fuente: Resources/Dialogos/aldeano_herrero.json (guion de la interfaz)
  id: aldeano_herrero
  lineas:
  - hablante: Herrero Mateo
    texto: "\xBFVas a enfrentar los peligros del camino? Tu espada parece de buena
      forja, pero las bestias de aqu\xED tienen pieles duras."
  - hablante: Herrero Mateo
    texto: "No olvides llevar suficientes pociones en tu morral. En el bosque, un
      descuido te costar\xE1 la vida."
  preguntaFinal: 
  opcionesFinal: []
