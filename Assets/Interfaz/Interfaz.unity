  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f079753526715c44daf397429d8a29c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RPG.UI.ConversacionDatos
  numero: 1
  titulo: "Taberna: Jorge y la inscripci\xF3n de la espada"
  parte: 1
  tipo: Charla con PNJ
  fuente: Data/DialogosNPC/DialogoBar.asset (texto que ya usa el juego)
  id: dialogo_bar
  lineas:
  - hablante: Jorge
    texto: "\xA1Mujer de malas ma\xF1as largo de aqui.!"
  - hablante: Jorge
    texto: "Esa chica es muy extra\xF1a. tiene ojos de angel y pelo de diablo. No
      puede ser mas que una bruja."
  - hablante: "H\xE9roe"
    texto: Mmmmmm.
  - hablante: Jorge
    texto: "Disculpa forastera \xBFpodrias leer el texto en tu espada?"
  - hablante: "H\xE9roe"
    texto: ...
  - hablante: "H\xE9roe"
    texto: Por su maldad, un alma fue castigada. Gracias a un noble caballero, atrapada
      por siempre en la nada...
  - hablante: "H\xE9roe"
    texto: No busques el maldito espejo, pues si atrapa tu reflejo, tu vida en una
      eterna agonia se convertira.
  - hablante: Jorge
    texto: Efectivamente. Hubo un mago adorador de Moloch, un ser vivo que atormento
      esta comarca...
  - hablante: Jorge
    texto: "Hasta que por fin alguien logro encerrar a esta bestia en una carcel
      magica...JAJAJA \xA1CUENTO DE HADAS!"
  preguntaFinal: 
  opcionesFinal: []
