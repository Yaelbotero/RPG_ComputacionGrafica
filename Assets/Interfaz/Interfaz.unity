  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f079753526715c44daf397429d8a29c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RPG.UI.ConversacionDatos
  numero: 9
  titulo: Posadera Teresa
  parte: 2
  tipo: Charla con PNJ
  fuente: Resources/Dialogos/aldeano_posadera.json (guion de la interfaz)
  id: aldeano_posadera
  lineas:
  - hablante: Posadera Teresa
    texto: "Ten cuidado con los forasteros y con esa chica de la que Jorge desconf\xEDa
      tanto. Hay miradas que traen desgracia."
  - hablante: Posadera Teresa
    texto: "Nadie viaja hacia la aldea de Zuhayr desde hace a\xF1os. Dicen que est\xE1
      maldita y que la niebla nunca se disipa."
  preguntaFinal: 
  opcionesFinal: []
