MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1612239366}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f079753526715c44daf397429d8a29c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RPG.UI.ConversacionDatos
  numero: 11
  titulo: Helena en el bosque (territorio de los groks)
  parte: 3
  tipo: Charla con PNJ
  fuente: Data/DialogosNPC/DialogoNun_Bosque.asset (texto que ya usa el juego)
  id: dialogo_nun_bosque
  lineas:
  - hablante: Helena
    texto: "Uf... estoy agotada, ya no aguanto un paso m\xE1s."
  - hablante: "H\xE9roe"
    texto: La verdad nunca imagine que estuviese tan lejos...
  - hablante: "H\xE9roe"
    texto: Mas vale dame toda la recompensa, estoy es harta.
  - hablante: Helena
    texto: Jsjsjs ya quisieras...
  - hablante: Helena
    texto: Pero mira, ya llegamos al bosque...
  - hablante: Helena
    texto: Hay que tener mucho cuidado, estamos en territorio de los groks.
  - hablante: "H\xE9roe"
    texto: Tranquila, solo sigueme y mantente atras de mi.
  - hablante: Helena
    texto: Por supuesto.
  preguntaFinal: 
  opcionesFinal: []
