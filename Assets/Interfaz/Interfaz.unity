  m_Script: {fileID: 11500000, guid: f079753526715c44daf397429d8a29c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RPG.UI.ConversacionDatos
  numero: 6
  titulo: Anciano Raimundo
  parte: 2
  tipo: Charla con PNJ
  fuente: Resources/Dialogos/aldeano_anciano.json (guion de la interfaz)
  id: aldeano_anciano
  lineas:
  - hablante: Anciano Raimundo
    texto: La ventisca de Monegros no perdona a nadie, forastero.
  - hablante: Anciano Raimundo
    texto: "Si pretendes cruzar el bosque hacia S\xE1stago, ten cuidado con las sombras.
      De noche se escuchan aullidos que hielan la sangre."
  preguntaFinal: 
  opcionesFinal: []
