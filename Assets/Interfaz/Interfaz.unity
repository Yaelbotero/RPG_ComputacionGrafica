  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RPG.UI.ConversacionDatos
  numero: 7
  titulo: Guardia Rodrigo
  parte: 2
  tipo: Charla con PNJ
  fuente: Resources/Dialogos/aldeano_guardia.json (guion de la interfaz)
  id: aldeano_guardia
  lineas:
  - hablante: Guardia Rodrigo
    texto: "Tranquilo por aqu\xED, forastero. Mientras est\xE9s dentro de la empalizada
      del pueblo, la ley te protege."
  - hablante: Guardia Rodrigo
    texto: "M\xE1s all\xE1 de las puertas s\xF3lo reinan el fr\xEDo y las alima\xF1as.
      No salgas sin estar bien preparado."
  preguntaFinal: 
  opcionesFinal: []
