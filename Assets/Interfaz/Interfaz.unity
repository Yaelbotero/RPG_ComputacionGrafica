--- !u!114 &1848836346
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1848836344}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f079753526715c44daf397429d8a29c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RPG.UI.ConversacionDatos
  numero: 15
  titulo: 'Final: derrota'
  parte: 4
  tipo: Final
  fuente: Resources/Dialogos/fin_derrota.json (guion de la interfaz)
  id: fin_derrota
  lineas:
  - hablante: "H\xE9roe"
    texto: "Maldici\xF3n... mis fuerzas me abandonan... La espada cae de mis manos..."
  - hablante: Lupus
    texto: "\xA1Ja, ja, ja! \xA1Otro insensato cuyos huesos alimentar\xE1n el piso
      de esta caverna!"
  - hablante: Helena
    texto: "Te lo advert\xED en silencio: no deb\xEDas buscar el reflejo del espejo.
      Tu alma ahora pertenece a Moloch."
  - hablante: Narrador
    texto: "La oscuridad se apodera de tu visi\xF3n. Tu viaje ha terminado en la
      tumba olvidada de Zuhayr, y tu nombre se pierde en la nada..."
  preguntaFinal: 
  opcionesFinal: []
