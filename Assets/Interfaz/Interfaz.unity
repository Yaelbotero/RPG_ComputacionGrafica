MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 999852835}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f079753526715c44daf397429d8a29c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RPG.UI.ConversacionDatos
  numero: 14
  titulo: 'Final: victoria'
  parte: 4
  tipo: Final
  fuente: Resources/Dialogos/fin_victoria.json (guion de la interfaz)
  id: fin_victoria
  lineas:
  - hablante: Lupus
    texto: "\xA1Maldito seas...! \xA1Moloch... no permitas que vuelva al abismo...!"
  - hablante: Narrador
    texto: Lupus y Helena se desvanecen en un torbellino de cenizas mientras el espejo
      maldito estalla en mil pedazos con un crujido ensordecedor.
  - hablante: Narrador
    texto: "De repente, una luz c\xE1lida y celestial inunda la caverna, disipando
      la densa niebla y el hedor a muerte de siglos pasados."
  - hablante: "H\xE9roe"
    texto: "Se acab\xF3... La maldici\xF3n de Monegros ha sido purgada."
  - hablante: Narrador
    texto: "Al fondo de la sala, iluminados por la luz, yacen en paz los antiguos
      soldados ca\xEDdos, junto a opulentos cofres rebosantes de oro, gemas y reliquias
      paganas."
  - hablante: "H\xE9roe"
    texto: "Llenar\xE9 mi alforja con el oro que por derecho me pertenece tras semejante
      haza\xF1a. El camino hacia Zaragoza me espera."
  - hablante: Narrador
    texto: "Con la gloria de la victoria y una fortuna entre manos, nuestro h\xE9roe
      asciende a la superficie con una sonrisa, listo para emprender nuevas leyendas."
  preguntaFinal: 
  opcionesFinal: []
