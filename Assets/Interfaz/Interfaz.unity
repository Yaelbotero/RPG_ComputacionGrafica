MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 836827367}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f079753526715c44daf397429d8a29c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RPG.UI.ConversacionDatos
  numero: 10
  titulo: Salida del pueblo hacia el bosque
  parte: 2
  tipo: "Cinem\xE1tica"
  fuente: Resources/Dialogos/salida_pueblo.json (guion de la interfaz)
  id: salida_pueblo
  lineas:
  - hablante: "H\xE9roe"
    texto: "Las puertas del pueblo quedan atr\xE1s. El viento de Monegros azota con
      fuerza el inicio del bosque."
  - hablante: Helena
    texto: "Debemos darnos prisa. Son dos d\xEDas de marcha hasta S\xE1stago cruzando
      esta espesura."
  - hablante: "H\xE9roe"
    texto: "Mant\xE9n tus ojos abiertos, Helena. Los aldeanos no ment\xEDan: el bosque
      est\xE1 plagado de bestias y trampas."
  - hablante: Helena
    texto: "Conf\xEDo en tu espada. Sigamos la senda sin desviarnos."
  preguntaFinal: 
  opcionesFinal: []
