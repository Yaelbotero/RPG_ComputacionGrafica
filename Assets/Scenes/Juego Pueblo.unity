  m_Script: {fileID: 11500000, guid: 1895b15a2e0e1b547904e9ca9138fd14, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TextManager
  dialogoPanel: {fileID: 192925563}
  dialogoText: {fileID: 1385955396}
  lineasDialogo:
  - "BARISTA(Jorge): \xA1Mujer de malas ma\xF1as largo de aqui.!"
  - "BARISTA(Jorge): Esa chica es muy extra\xF1a. tiene ojos de angel y pelo de diablo.
    No puede ser mas que una bruja. "
  - 'PROTA: Mmmmmm.'
  - "BARISTA(Jorge): Disculpa forastero \xBFpodrias leer el texto en tu espada?"
  - 'PROTA: ...'
  - 'PROTA: Por su maldad, un alma fue castigada. Gracias a un noble caballero, atrapada
    por siempre en la nada...'
  - 'PROTA: No busques el maldito espejo, pues si atrapa tu reflejo, tu vida en una
    eterna agonia se convertira.'
  - 'BARISTA(Jorge): Efectivamente. Hubo un mago adorador de Moloch, un ser vivo
    que atormento esta comarca...'
  - "BARISTA(Jorge): Hasta que por fin alguien logro encerrar a esta bestia en una
    carcel magica...JAJAJA \xA1CUENTO DE HADAS!"
