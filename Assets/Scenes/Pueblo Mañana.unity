  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1150052835}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 180d6833488abe9418b9ceb8a90488d5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TextManagerNun
  "se\xF1alDialogo": {fileID: 496153889}
  dialogoPanel: {fileID: 1768380423}
  textoDialogo: {fileID: 89008636}
  dialogo: {fileID: 11400000, guid: 4f754f2d878d9f247ac8d7e3c587f8fd, type: 2}
  barista: {fileID: 0}
  dialogoNoche: {fileID: 11400000, guid: 7a3d597c8e777c34d92c3ee688f8559d, type: 2}
  lineasDeDialogo:
  - 'PROTA: Hey... '
  - "\xBF?: Hola, mi nombre es Helena, y perd\xF3n, no te dejaba de mirar puesto
    que te ves valiente y fuerte..."
  - 'HELENA: Yo no soy ninguna bruja como les dijeron, pero aqui todos creen que
    si, solo por ser monja...'
  - "HELENA: Mi abuela si fue una bruja, pero fue hace a\xF1os...muchos a\xF1os..."
  - 'HELENA: En sus ultimos momentos de vida, mi abuela me conto sobre una tumba
    pagana, llena de riquezas...'
  - "HELENA: Me dejo esta guia la cual ya descifr\xE9, y me gustaria reclamar la
    recompensa..."
  - "HELENA: Me gustaria que me acompa\xF1asen, ya que nadie es lo suficientemente
    valiente para ir conmigo..."
  - 'PROTA: La verdad estoy impactada, nadie nunca antes me habia hecho tal oferta
    de forma tan repentina...'
  - 'PROTA: Pero por un precio justo, estare feliz de proteger a tan bella dama.'
  - "HELENA: \xA1SI!... digo, claro, podriamos ir mitad y mitad \xBFte parece justo?"
  - 'PROTA: No, no, es demasiado, ya es bastante paga el poder hablar contigo justo
    ahora...'
  - "PROTA: \xBFTe parece si me das un tercio de las recompensas y nos vemos ma\xF1ana
    al amanecer? "
  - "HELENA: Por supuesto, mas que perfecto, nos vemos ma\xF1ana. "
  destinoAlTerminar: {x: 9.45, y: -3.171}
